          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você quer também apagar a pasta de dados de %@? Você pode mantê-la para uso futuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите ли вы также удалить папку данных от %@? Вы можете её оставить для дальнейшего использования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du också ta bort datamappen %@? Du kan behålla den för framtida användning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'nin veri klasörünü de silmek ister misiniz? İleride kullanmak üzere saklayabilirsiniz."
          }
