    "lc.appBanner.confirmRunWhenMultitasking" : {
      "comment" : "lc.appBanner.confirmRunWhenMultitasking",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض التطبيقات تعمل في وضع متعدد المهام. تشغيل هذا التطبيق سوف يغلق هذه التطبيقات، هل تود المتابعة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Apps werden im Multitasking-Modus ausgeführt. Wenn Sie diese Anwendung ausführen, werden diese Anwendungen beendet. Fortsetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some apps are running in multitask mode. Running this app will terminate those apps. Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas apps se están ejecutando en modo multitarea. Ejecutar esta app cerrará esas apps. ¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines applications sont en mode multitâche. Exécuter cette application mettra fin à ces applications. Continuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune app sono in esecuzione in modalità multitask. L'esecuzione di questa app terminerà quelle applicazioni. Vuoi Continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のアプリがマルチタスクで実行中です。このアプリを起動すると、マルチタスクで実行しているアプリは終了します。続けますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 앱이 멀티태스킹 중입니다. 이 앱을 실행할 경우 멀티태스킹 중인 앱이 모두 닫힙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre aplikacje są już w trybie wielozadaniowości. Uruchomienie tej aplikacji zakończy pracę tamtych aplikacji. Czy chcesz kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns aplicativos estão sendo executados no modo multitarefa. Executar este aplicativo irá encerrar os outros. Deseja continuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые приложения работают в режиме многозадачности. Запуск этого приложения завершит их работу. Продолжить?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa appar körs i Multititask läge. Att köra denna app kommer att avsluta dessa appar. Fortsätt?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı uygulamalar çoklu görev modunda çalışıyor. Bu uygulamayı çalıştırmak, söz konusu uygulamaları sonlandıracaktır. Devam etmek istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vài app đang chạy chế độ đa nhiệm. Mở app này sẽ dừng các app kia. Tiếp tục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一些App正在以多任务模式运行，启动此App会终止这些App，要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚有應用程式在多任務模式執行。執行此App將停止那些應用程式。要繼續嗎？"
          }
        }
      }
    },
