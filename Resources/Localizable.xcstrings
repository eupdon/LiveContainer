    "lc.appList.empty.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على زر + في الزاوية العليا لتثبيت ملف IPA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
