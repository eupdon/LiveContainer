    "lc.appBanner.deleteDataMsg %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد ان تحذف ملف البيانات لـ%@؟ يمكنك أن تبقيها لأستخدام مستقبلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie außerdem den Datenordner von %@ löschen? Sie können ihn für eine spätere Verwendung behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you also want to delete data folder of %@? You can keep it for future use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿También quieres eliminar la carpeta de datos de %@? Puedes conservarla para usarla más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous également supprimer le dossier de données de %@ ? Vous pouvez le conserver pour un usage ultérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi anche eliminare la cartella file %@? Puoi tenerla per uso futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のデータフォルダも削除しますか？将来のために残しておくこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 데이터 폴더도 함께 삭제하시겠습니까? 데이터를 유지할 경우 나중에 다시 사용할 수 있습니다."
